# Official model API for optional later research. Leave unset to use labelled fixture mode.
# Never put a real key in this file or in git. Do not start paid calls until you choose a provider.
# Required together if you enable real model mode later:
PIIA_MODEL_PROVIDER=
# Provider must be openai, anthropic, or xai and must match the selected host.
# Allowed base URLs only: https://api.openai.com  https://api.anthropic.com  https://api.x.ai
PIIA_MODEL_BASE_URL=
PIIA_MODEL_NAME=
PIIA_MODEL_API_KEY=
